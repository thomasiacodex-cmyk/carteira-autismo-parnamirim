# Carteira Autismo Parnamirim — Configuração de Produção

# Database (caminho relativo ao diretório do app)
DATABASE_URL=./local.db

# URL pública do site (SEM barra no final)
NEXT_PUBLIC_APP_URL=https://seudominio.com.br

# Porta do servidor (Hostinger geralmente usa 3000)
PORT=3000

# Session secret — OBRIGATÓRIO, mín. 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=COLE_AQUI_O_RESULTADO_DO_OPENSSL

# Admin panel password — use uma senha forte
ADMIN_PASSWORD=SUA_SENHA_ADMIN_FORTE

# SMTP Email (obrigatório em produção para e-mails funcionarem)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@seudominio.com.br
SMTP_PASSWORD=sua-senha-email
EMAIL_FROM=CIPTEA Parnamirim <noreply@seudominio.com.br>

# Node environment
NODE_ENV=production
